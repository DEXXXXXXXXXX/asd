# ضع بيانات البوت هنا ثم احفظ الملف باسم .env (بدون .example)

# توكن البوت (من Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=ضع_التوكن_هنا

# ايدي التطبيق (Application ID)
CLIENT_ID=ضع_الايدي_هنا

# اختياري: ايدي السيرفر لتسجيل الأوامر بسرعة أثناء التجربة (تظهر فوراً)
# اتركه فارغاً لتسجيل الأوامر بشكل عام على كل السيرفرات (قد تأخذ حتى ساعة للظهور)
GUILD_ID=
